# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30
# Maximum Gemini calls per minute (0 = no limit). Protects the quota on a public demo.
AI_CALLS_PER_MINUTE=10

# SQLite file stored in the instance/ folder. Any SQLAlchemy URL works,
# e.g. mysql+pymysql://user:password@localhost/health (requires the matching driver)
DATABASE_URL=sqlite:///health.db

FLASK_DEBUG=1
