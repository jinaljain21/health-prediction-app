# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# SQLite file stored in the instance/ folder. Any SQLAlchemy URL works,
# e.g. mysql+pymysql://user:password@localhost/health (requires the matching driver)
DATABASE_URL=sqlite:///health.db

FLASK_DEBUG=1
